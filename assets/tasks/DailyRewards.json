{
    "task": [
        {
            "name": "DailyRewards",
            "label": "$task.DailyRewards.label",
            "entry": "DailyRewardsMain",
            "description": "$task.DailyRewards.description",
            "option": [
                "DailyRewardsFriendPoints",
                "DailyRewardsEmail",
                "DailyRewardsRankingRewards",
                "DailyRewardsMission",
                "DailyRewardsPassMain",
                "DailyRewardsDailyLogin",
                "DailyRewardsFreeRecruit",
                "DailyRewardsFashionRecruit"
            ],
            "group": [
                "daily"
            ]
        }
    ],
    "option": {
        "DailyRewardsFriendPoints": {
            "type": "switch",
            "label": "$option.DailyRewardsFriendPoints.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsFriendPoints": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsFriendPoints": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyRewardsEmail": {
            "type": "switch",
            "label": "$option.DailyRewardsEmail.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsEmail": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsEmail": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyRewardsRankingRewards": {
            "type": "switch",
            "label": "$option.DailyRewardsRankingRewards.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsRankingRewards": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsRankingRewards": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyRewardsMission": {
            "type": "switch",
            "label": "$option.DailyRewardsMission.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsMission": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsMission": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyRewardsPassMain": {
            "type": "switch",
            "label": "$option.DailyRewardsPassMain.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsPassMain": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsPassMain": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyRewardsDailyLogin": {
            "type": "switch",
            "label": "$option.DailyRewardsDailyLogin.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsDailyLogin": {
                            "enabled": true
                        },
                        "DailyLoginFindCurrentActivity": {
                            "recognition": {
                                "param": {
                                    "custom_recognition_param": {
                                        "template": [
                                            "DailyRewards/DailyLogin/HeroDays.png"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsDailyLogin": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyRewardsFreeRecruit": {
            "type": "switch",
            "label": "$option.DailyRewardsFreeRecruit.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsFreeRecruitMain": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsFreeRecruitMain": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyRewardsFashionRecruit": {
            "type": "switch",
            "default_case": "Yes",
            "label": "$option.DailyRewardsFashionRecruit.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyRewardsFashionRecruitMain": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyRewardsFashionRecruitMain": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    }
}
