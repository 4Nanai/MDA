{
    "DialoguesSkipStory": {
        "desc": "跳过剧情",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1218,
                    9,
                    39,
                    16
                ],
                "expected": [
                    ".*SKI.*"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "DialoguesClickContinue": {
        "desc": "点击继续",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    622,
                    646,
                    336,
                    70
                ],
                "template": [
                    "Dialogues/Continue.png"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "DialoguesOptionOCR": {
        "desc": "对话选项OCR",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    452,
                    383,
                    56,
                    324
                ],
                "expected": [
                    "[0-9]",
                    "[①②③④⑤⑥⑦⑧⑨]"
                ],
                "threshold": 0.7
            }
        }
    },
    "DialoguesOptionTemplate": {
        "desc": "对话选项模板",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    452,
                    383,
                    56,
                    324
                ],
                "template": [
                    "Common/DialogueOption1.png",
                    "Common/DialogueOption2.png"
                ],
                "green_mask": true
            }
        }
    },
    "DialoguesClickOption": {
        "desc": "点击选项",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "DialoguesOptionTemplate",
                    "DialoguesOptionOCR"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    50,
                    0,
                    0,
                    0
                ]
            }
        }
    },
    "DialoguesMainVisible": {
        "desc": "剧情的标识",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    953,
                    0,
                    327,
                    75
                ],
                "expected": [
                    ".*HIDE.*",
                    ".*AUTO.*",
                    ".*LOG.*",
                    ".*SKIP.*"
                ]
            }
        }
    },
    "DialoguesSkipWorkflow": {
        "desc": "跳过剧情全流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DialoguesMainVisible"
                ]
            }
        },
        "rate_limit": 200,
        "next": [
            "DialoguesSkipStoryAndEndTask",
            "[JumpBack]DialoguesClickContinue",
            "[JumpBack]DialoguesClickOption",
            "[JumpBack]CommonClickBlank"
        ]
    },
    "DialoguesSkipStoryAndEndTask": {
        "desc": "跳过剧情并结束流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DialoguesSkipStory"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "DialoguesSkipStoryAndEndTask",
            "CommonEndTask"
        ]
    }
}
