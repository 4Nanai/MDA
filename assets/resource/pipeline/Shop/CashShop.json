{
    "CashShopMain": {
        "next": [
            "HallEnterCashShop",
            "[JumpBack]NavigationEnterHall"
        ]
    },
    "HallEnterCashShop": {
        "desc": "进入付费商店",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    358,
                    441,
                    59,
                    21
                ],
                "expected": [
                    ".*商店.*"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        // Need to wait for potential pop-up customer limitation after entering the cash shop
        "rate_limit": 3000,
        "next": [
            "[JumpBack]CashShopConfirmLimitation",
            "CashShopCornerFlow"
        ]
    },
    "CashShopConfirmLimitation": {
        "desc": "确认付费商店限制",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CashShopCustomerAgeLimitation",
                    "CashShopConsumerLimitation"
                ]
            }
        },
        "action": "Click",
        "next": [
            "[JumpBack]CommonConfirmAction",
            "CashShopCornerFlow"
        ]
    },
    "CashShopCustomerAgeLimitation": {
        "desc": "付费商店年龄限制",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    512,
                    436,
                    108,
                    53
                ],
                "expected": [
                    "20岁以上",
                    "无限制"
                ]
            }
        }
    },
    "CashShopConsumerLimitation": {
        "desc": "付费商店消费限制",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    579,
                    137,
                    119,
                    90
                ],
                "expected": [
                    "消费限制"
                ]
            }
        }
    },
    "CashShopMainPageEntered": {
        "desc": "处于付费商店",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    15,
                    70,
                    25
                ],
                "expected": [
                    ".*商店.*"
                ]
            }
        }
    },
    "CashShopCornerFlow": {
        "desc": "付费商店流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CashShopMainPageEntered",
                    "CommonNoTransparentMask"
                ]
            }
        },
        "next": [
            "[JumpBack]ShopStepUpPackagePurchase",
            "ShopChooseOrdinaryPackage"
        ]
    },
    "ShopStepUpPackagePurchase": {
        "desc": "购买StepUp礼包",
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    783,
                    389,
                    49,
                    28
                ],
                "expected": [
                    "免费"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "CommonConfirmReward"
        ]
    },
    "ShopChooseOrdinaryPackage": {
        "desc": "选择普通礼包",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1,
                    138,
                    543,
                    44
                ],
                "template": [
                    "CashShop/OrdinaryPackage.png"
                ],
                "threshold": [
                    0.9
                ]
            }
        },
        "pre_wait_freezes": 500,
        "action": {
            "type": "Click"
        },
        "next": [
            "[JumpBack]CashShopClickRedDot",
            "CommonEndTask"
        ]
    },
    "CashShopClickRedDot": {
        "desc": "点击周期性礼包红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    14,
                    178,
                    457,
                    49
                ],
                "template": [
                    "Common/RedDot.png"
                ],
                "index": -1
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "CashShopClickRewardRedDot",
            "CashShopClickRedDot"
        ]
    },
    "CashShopClickRewardRedDot": {
        "desc": "点击周期性礼包内的奖励红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    12,
                    222,
                    125,
                    69
                ],
                "template": [
                    "Common/RedDot.png"
                ],
                "index": -1
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "CommonConfirmReward",
            "CashShopClickRewardRedDot"
        ],
        "on_error": [
            "CommonEndTask"
        ]
    }
}
