                "roi": [
                    1116,
                    91,
                    163,
                    66
                ],
                "template": [
                    "Common/RedDot.png",
                    "Common/PassRedDot.png"
                ]
            }
        },
        "next": [
            "[JumpBack]DailyRewardsClickPassRewardRedDot",
