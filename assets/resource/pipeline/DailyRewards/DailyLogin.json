            "CommonEndTask"
        ]
    },
    "DailyRewardsDailyLoginStart": {
        "desc": "每日登录奖励入口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "NavigationArkVisible"
                ]
            }
