{
    "DailyRewardsDailyLogin": {
        "desc": "每日登录奖励",
        "max_hit": 1,
        "next": [
            "DailyRewardsDailyLoginStart",
            "CommonEndTask"
        ]
    },
    "DailyRewardsDailyLoginStart": {
        "desc": "每日登录奖励入口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "NavigationArkVisible"
                ]
            }
        },
        "next": [
            "DailyLoginOpenActivityList",
            "CommonEndTask"
        ]
    },
    "DailyLoginOpenActivityList": {
        "desc": "打开当前活动列表",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "CommonTemplateOCRRecognition",
                "custom_recognition_param": {
                    "template": [
                        "Common/RedDot.png"
                    ],
                    "expected": [
                        "活动"
                    ]
                },
                "roi": [
                    1217,
                    257,
                    57,
                    57
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "DailyLoginWaitActivityList"
        ]
    },
    "DailyLoginWaitActivityList": {
        "desc": "等待活动列表加载",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "DailyRewards/DailyLogin/BreakingNews.png"
                ],
                "roi": [
                    431,
                    68,
                    219,
                    66
                ]
            }
        },
        "next": [
            "DailyLoginFindCurrentActivity",
            "CommonGoBack"
        ]
    },
    "DailyLoginFindCurrentActivity": {
        "desc": "查找当前活动",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DailyLoginOpenActivityListRecognition",
                "custom_recognition_param": {
                    "template": [
                        "DailyRewards/DailyLogin/HeroDays.png"
                    ]
                },
                "roi": [
                    801,
                    142,
                    37,
                    520
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "DailyLoginRewardsClaim"
        ]
    },
    "DailyLoginRewardsClaim": {
        "desc": "领取每日登录奖励",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    686,
                    657,
                    139,
                    34
                ],
                "expected": [
                    ".*全部.*"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "repeat": 3,
        "repeat_delay": 100,
        "post_wait_freezes": 500,
        "next": [
            "[JumpBack]CommonConfirmReward",
            "NavigationEnterHall"
        ]
    }
}
