    "DailyLoginSearch": {
        "desc": "寻找每日登录奖励图标",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    9,
                    60,
                    151,
                    52
                ],
                "template": [
                    "DailyRewards/DailyLogin/HeroDays.png" //占位，应该去task页面修改
